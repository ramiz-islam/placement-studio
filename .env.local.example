# Image generation — required for the Generate panel.
# Same key you already use for blog images.
OPENAI_API_KEY=

# Image model. gpt-image-1 is the default; gpt-image-1-mini is cheaper and faster.
OPENAI_IMAGE_MODEL=gpt-image-1

# Copy and Arabic register — required for Generate copy / Translate.
# Claude handles Najdi and Khaleeji register far better than a general model,
# which is why copy runs on Anthropic and images run on OpenAI.
ANTHROPIC_API_KEY=

# Optional override. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# If your shell already exports ANTHROPIC_API_KEY or OPENAI_API_KEY, Next will NOT
# override it from this file — an exported stale key wins and you get 401s. Use the
# PS_ prefixed names below to force this app to use yours instead.
# PS_OPENAI_API_KEY=
# PS_ANTHROPIC_API_KEY=
