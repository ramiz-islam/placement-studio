# ─── Image generation ──────────────────────────────────────────────
# Required for the Generate → Picture tab. Same key you use for blog images.
OPENAI_API_KEY=
# gpt-image-1 is the default; gpt-image-1-mini is cheaper and faster.
OPENAI_IMAGE_MODEL=gpt-image-1

# ─── Copy and Arabic register ──────────────────────────────────────
# Required for Generate → Words. Claude holds Najdi and Khaleeji register far
# better than a general model, which is why copy runs here and images run on OpenAI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# If your shell already exports ANTHROPIC_API_KEY or OPENAI_API_KEY, Next will NOT
# override it from this file — the exported stale key wins and you get 401s. Use the
# PS_ prefixed names to force this app to use yours instead.
# PS_OPENAI_API_KEY=
# PS_ANTHROPIC_API_KEY=

# ─── Deployment only ───────────────────────────────────────────────
# REQUIRED in production. Without it the deployment refuses every request, because
# this app holds API keys and spends money per generation. Any string; you enter it
# as the password in the browser's Basic-auth prompt (leave the username blank).
SITE_PASSWORD=

# Set automatically by Vercel when you add Blob storage to the project. With it,
# the generation library persists in production; without it, serverless
# filesystems are read-only and generations are not saved.
# BLOB_READ_WRITE_TOKEN=

# Figma OAuth (Connect Figma). Register an app at figma.com/developers/apps;
# redirect URL is <origin>/api/figma/callback. The cookie secret is any long random string.
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_COOKIE_SECRET=
