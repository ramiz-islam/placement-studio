{
  "name": "placement-studio",
  "version": "0.8.0",
  "private": true,
  "description": "Preview ad creative inside every channel's feed chrome, check safe zones, and generate statics from a single prompt.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start -p 3210",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:types": "wrangler types"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@vercel/blob": "^2.8.0",
    "ag-psd": "^31.0.2",
    "next": "^15.5.24",
    "openai": "^6.9.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2",
    "vercel": "^59.10.0",
    "wrangler": "^4.127.1"
  }
}
